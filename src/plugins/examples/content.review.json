{
  "type": "content.review",
  "name": "内容审核",
  "description": "按给定标准审核文本并返回结论和依据。",
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {"content": {"type": "string"}, "criteria": {"type": "string"}},
    "required": ["content"], "additionalProperties": false
  },
  "instructions": "审核输入的 content。criteria 是本次审核标准，未提供时检查准确性、清晰度和明显问题。自主完成调查，返回 approved 和 reasons。通过 complete_task 提交最终结果。",
  "result_schema": {
    "type": "object",
    "properties": {"approved": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string"}}},
    "required": ["approved", "reasons"], "additionalProperties": false
  },
  "capabilities": {"tools": [], "image_generation": false, "web_search": false},
  "resources": [],
  "delivery": {"mode": "none"}
}
