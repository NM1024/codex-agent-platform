# Example placeholders only. deploy.sh init generates distinct random credentials.
INGRESS_TOKEN=replace-with-independent-ingress-token
RUNNER_TOKEN=replace-with-independent-runner-token
PLATFORM_DATA_DIR=/data/codex-agent-platform
PLATFORM_PORT=3004
MANAGER_PORT=3007

# First-start defaults. Later change these through Admin or management MCP.
CODEX_MODEL=gpt-6.1-sol
QUEUE_LIMIT=10000
CONCURRENCY=1
TASK_TIMEOUT_MS=2400000
TOOL_TIMEOUT_MS=180000
EXECUTION_PAUSED=false

# Optional named HTTP destinations. Prefer setting these in Admin.
# PLATFORM_HTTP_TARGETS_JSON='{"example":{"url":"https://example.invalid/callback","token":"replace-with-target-token"}}'
# Admin has an independent password generated at manager/initial-password.
